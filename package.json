{
  "name": "traceproof-qa",
  "version": "2.1.0",
  "private": true,
  "description": "Local-first QA reproduction workspace with executable browser scenarios, evidence timeline and Playwright spec export.",
  "type": "module",
  "scripts": {
    "start": "node server.js",
    "dev": "node --watch server.js",
    "test": "node --test tests/*.test.js",
    "check": "node --check server.js && node --check public/app.js && node --test tests/*.test.js",
    "ci": "npm run check && npm audit --omit=dev",
    "docker:up": "docker compose up --build -d",
    "docker:down": "docker compose down",
    "docker:logs": "docker compose logs -f app"
  },
  "engines": {
    "node": ">=20"
  },
  "license": "MIT",
  "dependencies": {
    "jszip": "^3.10.2",
    "pg": "^8.16.3",
    "topojson-client": "^3.1.0",
    "world-atlas": "^2.0.2"
  },
  "devDependencies": {
    "@playwright/test": "^1.65.0"
  }
}
